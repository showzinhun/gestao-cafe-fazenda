# Copie para .env e ajuste. Valores de desenvolvimento local (docker compose).
# Conexão da aplicação: papel sem privilégios de dono, sujeito às políticas RLS.
DATABASE_URL="postgresql://cafe_app_login:cafe_app_dev@localhost:5432/cafe"
# Conexão de migração e seed: dono das tabelas (não usar na aplicação).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cafe"
# Senha do papel da aplicação, usada por `npm run db:papel-app`.
APP_DB_PASSWORD="cafe_app_dev"
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"
AUTH_TRUST_HOST="true"
