// Fase 0: plataforma e acesso (§4.1), fazenda mínima e auditoria (§4.9).
// Convenções (§4): tabelas e colunas em snake_case, ids UUID.
// O isolamento por empresa é feito por políticas RLS (migração *_rls_multiempresa).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // papel da aplicação, sujeito à RLS
  directUrl = env("DIRECT_URL") // dono das tabelas: migrações e seed
}

enum StatusEmpresa {
  ATIVA
  SUSPENSA

  @@map("status_empresa")
}

enum Perfil {
  ADMIN_EMPRESA
  GESTOR
  OPERADOR
  APONTADOR
  FINANCEIRO
  COMERCIAL
  CONSULTA

  @@map("perfil")
}

model Empresa {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  cnpj          String?
  ie            String?
  plano         String        @default("BASICO")
  status        StatusEmpresa @default(ATIVA)
  configuracoes Json          @default("{}")
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  alteradoEm    DateTime      @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)

  usuarios  UsuarioEmpresa[]
  fazendas  Fazenda[]
  auditoria Auditoria[]

  @@map("empresa")
}

model Usuario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String
  email      String   @unique
  senhaHash  String   @map("senha_hash")
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  alteradoEm DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)

  empresas UsuarioEmpresa[]
  fazendas UsuarioFazenda[]

  @@map("usuario")
}

model UsuarioEmpresa {
  usuarioId String   @map("usuario_id") @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  perfil    Perfil
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@id([usuarioId, empresaId])
  @@index([empresaId])
  @@map("usuario_empresa")
}

/// Fazenda (§4.2). O código (2–4 letras) entra no código de lote (§8).
model Fazenda {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  codigo      String
  nome        String
  produtorId  String?  @map("produtor_id") @db.Uuid
  municipio   String?
  uf          String?  @db.Char(2)
  pais        String   @default("BR") @db.Char(2)
  car         String?
  ie          String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  empresa    Empresa               @relation(fields: [empresaId], references: [id])
  produtor   Parceiro?             @relation(fields: [empresaId, produtorId], references: [empresaId, id])
  usuarios   UsuarioFazenda[]
  talhoes    Talhao[]
  locais     Local[]
  transicoes FluxoTransicao[]
  precos     TabelaPrecoColheita[]

  certificados FazendaCertificado[]
  movimentos   Movimento[]
  lotes        Lote[]

  turmas       Turma[]
  apontamentos Apontamento[]
  cargas       CargaColheita[]
  fechamentos  FechamentoPagamento[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@map("fazenda")
}

model UsuarioFazenda {
  usuarioId String @map("usuario_id") @db.Uuid
  fazendaId String @map("fazenda_id") @db.Uuid
  empresaId String @map("empresa_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  fazenda Fazenda @relation(fields: [empresaId, fazendaId], references: [empresaId, id])

  @@id([usuarioId, fazendaId])
  @@index([empresaId])
  @@map("usuario_fazenda")
}

model Auditoria {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  entidade      String
  entidadeId    String   @map("entidade_id")
  acao          String
  antes         Json?
  depois        Json?
  usuarioId     String?  @map("usuario_id") @db.Uuid
  data          DateTime @default(now()) @db.Timestamptz(6)
  ip            String?
  dispositivoId String?  @map("dispositivo_id")

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, entidade, entidadeId])
  @@map("auditoria")
}

// ---------------------------------------------------------------- Fase 1: cadastros (§4.2)

enum TipoPessoa {
  F
  J

  @@map("tipo_pessoa")
}

/// Parceiro (§4.2): produtor, cliente, operador ou transportador. Papéis em array.
model Parceiro {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String     @map("empresa_id") @db.Uuid
  tipoPessoa  TipoPessoa @map("tipo_pessoa")
  nome        String
  razaoSocial String?    @map("razao_social")
  cpfCnpj     String?    @map("cpf_cnpj")
  pais        String     @default("BR") @db.Char(2)
  papeis      String[]
  codigoErp   String?    @map("codigo_erp")
  ativo       Boolean    @default(true)
  criadoEm    DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?    @map("criado_por") @db.Uuid
  alteradoEm  DateTime   @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?    @map("alterado_por") @db.Uuid

  fazendas   Fazenda[]
  motoristas Motorista[]

  contratos Contrato[]
  amostras  Amostra[]

  @@unique([empresaId, id])
  @@index([empresaId, cpfCnpj])
  @@map("parceiro")
}

enum GeometriaTipo {
  PONTO
  POLIGONO

  @@map("geometria_tipo")
}

/// Talhão (§4.2) com geometria GeoJSON (WGS84, 6 casas) e área calculada.
model Talhao {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId       String         @map("empresa_id") @db.Uuid
  fazendaId       String         @map("fazenda_id") @db.Uuid
  codigo          String
  nome            String
  areaHaInformada Decimal?       @map("area_ha_informada") @db.Decimal(14, 4)
  areaHaCalculada Decimal?       @map("area_ha_calculada") @db.Decimal(14, 4)
  variedade       String?
  anoPlantio      Int?           @map("ano_plantio")
  geometria       Json?
  geometriaTipo   GeometriaTipo? @map("geometria_tipo")
  geometriaHash   String?        @map("geometria_hash") // SHA-256 da geometria normalizada: versão para a checagem (§10)
  ativo           Boolean        @default(true)
  criadoEm        DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor       String?        @map("criado_por") @db.Uuid
  alteradoEm      DateTime       @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor     String?        @map("alterado_por") @db.Uuid

  fazenda Fazenda               @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  precos  TabelaPrecoColheita[]

  movimentos Movimento[]
  lotes      LoteTalhao[]

  apontamentos Apontamento[]
  cargas       CargaColheita[]

  checagens ChecagemDesmatamento[]

  @@unique([fazendaId, codigo])
  @@unique([empresaId, id])
  @@map("talhao")
}

model Safra {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  codigo      String
  dataInicio  DateTime @map("data_inicio") @db.Date
  dataFim     DateTime @map("data_fim") @db.Date
  ativa       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  precos TabelaPrecoColheita[]

  movimentos Movimento[]
  lotes      Lote[]

  apontamentos Apontamento[]
  cargas       CargaColheita[]

  contratos Contrato[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@map("safra")
}

model TipoCafe {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  codigo      String
  nome        String
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  resultados EtapaTipoResultado[]

  lotes Lote[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@map("tipo_cafe")
}

model Peneira {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  codigo      String
  descricao   String
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  lotes Lote[]

  contratos Contrato[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@map("peneira")
}

enum UnidadeCapacidade {
  M2
  MEDIDA
  KG
  SACA

  @@map("unidade_capacidade")
}

/// Local físico de uma etapa (terreiro, secador, tulha, quadra do armazém).
model Local {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String             @map("empresa_id") @db.Uuid
  fazendaId         String?            @map("fazenda_id") @db.Uuid
  etapaId           String             @map("etapa_id") @db.Uuid
  codigo            String
  nome              String
  capacidade        Decimal?           @db.Decimal(14, 3)
  unidadeCapacidade UnidadeCapacidade? @map("unidade_capacidade")
  ativo             Boolean            @default(true)
  criadoEm          DateTime           @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor         String?            @map("criado_por") @db.Uuid
  alteradoEm        DateTime           @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor       String?            @map("alterado_por") @db.Uuid

  fazenda Fazenda? @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  etapa   Etapa    @relation(fields: [empresaId, etapaId], references: [empresaId, id])

  movimentos Movimento[]
  reservas   Reserva[]

  lotes LoteLocal[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@map("local")
}

model Turno {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  nome        String
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  @@unique([empresaId, nome])
  @@unique([empresaId, id])
  @@map("turno")
}

model Motorista {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId       String   @map("empresa_id") @db.Uuid
  nome            String
  cpf             String?
  cnh             String?
  placaPadrao     String?  @map("placa_padrao")
  transportadorId String?  @map("transportador_id") @db.Uuid
  telefone        String?
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor       String?  @map("criado_por") @db.Uuid
  alteradoEm      DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor     String?  @map("alterado_por") @db.Uuid

  transportador Parceiro? @relation(fields: [empresaId, transportadorId], references: [empresaId, id])

  embarques EmbarqueDetalhe[]

  @@unique([empresaId, id])
  @@map("motorista")
}

/// Certificado (§4.8). Validade por fazenda (fazenda_certificado) chega na Fase 7.
model Certificado {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  codigo      String
  nome        String
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  fazendas FazendaCertificado[]
  lotes    LoteCertificado[]

  contratos ContratoCertificado[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@map("certificado")
}

// ---------------------------------------------------------------- Fase 1: fluxo configurável (§4.3, §5)

enum ClasseEtapa {
  COLHEITA
  PROCESSAMENTO
  ESTOQUE
  SERVICO
  SAIDA

  @@map("classe_etapa")
}

enum ModeloResultado {
  NENHUM
  PERCENTUAL_POR_TIPO
  CAFE_E_PERDA
  POR_PENEIRA
  CONVERSAO_ESTOQUE

  @@map("modelo_resultado")
}

enum Unidade {
  MEDIDA
  KG

  @@map("unidade")
}

/// Etapa do fluxo. O código só conhece a classe, nunca o nome (regra 6).
model Etapa {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId       String          @map("empresa_id") @db.Uuid
  codigo          String
  nome            String
  classe          ClasseEtapa
  prefixoLote     String          @map("prefixo_lote")
  unidadeEntrada  Unidade         @map("unidade_entrada")
  unidadeSaida    Unidade         @map("unidade_saida")
  modeloResultado ModeloResultado @map("modelo_resultado")
  monitoraSecagem Boolean         @default(false) @map("monitora_secagem")
  umidadeMetaMin  Decimal?        @map("umidade_meta_min") @db.Decimal(5, 2)
  umidadeMetaMax  Decimal?        @map("umidade_meta_max") @db.Decimal(5, 2)
  exigeLocal      Boolean         @default(false) @map("exige_local")
  ordem           Int             @default(0)
  ativa           Boolean         @default(true)
  criadoEm        DateTime        @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor       String?         @map("criado_por") @db.Uuid
  alteradoEm      DateTime        @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor     String?         @map("alterado_por") @db.Uuid

  tiposResultado EtapaTipoResultado[]
  saidas         FluxoTransicao[]     @relation("origem")
  entradas       FluxoTransicao[]     @relation("destino")
  locais         Local[]

  movimentos Movimento[]
  lotes      Lote[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, prefixoLote])
  @@unique([empresaId, id])
  @@map("etapa")
}

model EtapaTipoResultado {
  empresaId  String @map("empresa_id") @db.Uuid
  etapaId    String @map("etapa_id") @db.Uuid
  tipoCafeId String @map("tipo_cafe_id") @db.Uuid
  ordem      Int    @default(0)

  etapa    Etapa    @relation(fields: [empresaId, etapaId], references: [empresaId, id])
  tipoCafe TipoCafe @relation(fields: [empresaId, tipoCafeId], references: [empresaId, id])

  @@id([etapaId, tipoCafeId])
  @@map("etapa_tipo_resultado")
}

/// Transição permitida. fazenda_id nulo = vale para a empresa toda (§5.2).
model FluxoTransicao {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  etapaOrigemId  String   @map("etapa_origem_id") @db.Uuid
  etapaDestinoId String   @map("etapa_destino_id") @db.Uuid
  fazendaId      String?  @map("fazenda_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor      String?  @map("criado_por") @db.Uuid

  origem  Etapa    @relation("origem", fields: [empresaId, etapaOrigemId], references: [empresaId, id])
  destino Etapa    @relation("destino", fields: [empresaId, etapaDestinoId], references: [empresaId, id])
  fazenda Fazenda? @relation(fields: [empresaId, fazendaId], references: [empresaId, id])

  @@index([empresaId, etapaOrigemId])
  @@map("fluxo_transicao")
}

// ---------------------------------------------------------------- Fase 1: preços de colheita e permissões

enum TipoColheitaPreco {
  MANUAL
  SEMIMECANIZADA

  @@map("tipo_colheita_preco")
}

/// Preço por medida (§4.5). Vale a regra mais específica: talhão > fazenda > empresa.
model TabelaPrecoColheita {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String            @map("empresa_id") @db.Uuid
  fazendaId      String?           @map("fazenda_id") @db.Uuid
  safraId        String            @map("safra_id") @db.Uuid
  tipoColheita   TipoColheitaPreco @map("tipo_colheita")
  talhaoId       String?           @map("talhao_id") @db.Uuid
  valorPorMedida Decimal           @map("valor_por_medida") @db.Decimal(14, 2)
  vigenciaInicio DateTime          @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime?         @map("vigencia_fim") @db.Date
  ativo          Boolean           @default(true)
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor      String?           @map("criado_por") @db.Uuid
  alteradoEm     DateTime          @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor    String?           @map("alterado_por") @db.Uuid

  fazenda Fazenda? @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  safra   Safra    @relation(fields: [empresaId, safraId], references: [empresaId, id])
  talhao  Talhao?  @relation(fields: [empresaId, talhaoId], references: [empresaId, id])

  @@map("tabela_preco_colheita")
}

/// Ajustes da empresa na matriz perfil × permissão (§3.2). Sem linha = valor padrão do domínio.
model PerfilPermissao {
  empresaId String  @map("empresa_id") @db.Uuid
  perfil    Perfil
  permissao String
  permitido Boolean

  @@id([empresaId, perfil, permissao])
  @@map("perfil_permissao")
}

// ---------------------------------------------------------------- Fase 2: rastreabilidade (§4.4, §8, §11)

enum StatusCertificadoFazenda {
  VALIDO
  VENCIDO
  SUSPENSO

  @@map("status_certificado_fazenda")
}

/// Certificado de uma fazenda com validade (§4.8). Base da herança de certificação (RN-08).
model FazendaCertificado {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String                   @map("empresa_id") @db.Uuid
  fazendaId      String                   @map("fazenda_id") @db.Uuid
  certificadoId  String                   @map("certificado_id") @db.Uuid
  numero         String?
  validadeInicio DateTime                 @map("validade_inicio") @db.Date
  validadeFim    DateTime                 @map("validade_fim") @db.Date
  arquivoUrl     String?                  @map("arquivo_url")
  arquivoId      String?                  @map("arquivo_id") @db.Uuid
  motivoStatus   String?                  @map("motivo_status")
  status         StatusCertificadoFazenda @default(VALIDO)
  criadoEm       DateTime                 @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor      String?                  @map("criado_por") @db.Uuid
  alteradoEm     DateTime                 @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor    String?                  @map("alterado_por") @db.Uuid

  fazenda     Fazenda     @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  certificado Certificado @relation(fields: [empresaId, certificadoId], references: [empresaId, id])
  arquivo     Arquivo?    @relation(fields: [empresaId, arquivoId], references: [empresaId, id])

  @@unique([empresaId, id])
  @@index([empresaId, fazendaId])
  @@map("fazenda_certificado")
}

/// Numeração sequencial por empresa (ex.: movimentos de cada etapa). Incremento atômico.
model Contador {
  empresaId String @map("empresa_id") @db.Uuid
  chave     String
  valor     Int

  @@id([empresaId, chave])
  @@map("contador")
}

enum StatusMovimento {
  ABERTO
  PROCESSADO
  FINALIZADO
  ESTORNADO

  @@map("status_movimento")
}

enum StatusLote {
  ABERTO
  PARCIAL
  UTILIZADO
  ESTORNADO

  @@map("status_lote")
}

enum OrigemLote {
  COLHEITA
  TRANSFERENCIA
  PROCESSO

  @@map("origem_lote")
}

enum TipoServico {
  BLEND
  CATACAO
  REBENEFICIO
  REAPROVEITAMENTO

  @@map("tipo_servico")
}

enum ModoColheita {
  MANUAL
  SEMIMECANIZADA
  MECANICA

  @@map("modo_colheita")
}

enum FinalidadeReserva {
  TRANSFERENCIA
  CONTRATO
  SERVICO
  EMBARQUE

  @@map("finalidade_reserva")
}

enum OrigemReserva {
  NENHUMA
  TRANSFERENCIA
  CONTRATO
  SERVICO
  EMBARQUE

  @@map("origem_reserva")
}

enum StatusReserva {
  ATIVA
  CONSUMIDA
  CANCELADA

  @@map("status_reserva")
}

/// Um processamento numa etapa: consome lotes (entradas) e gera lotes (§2, §4.4).
model Movimento {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String            @map("empresa_id") @db.Uuid
  etapaId        String            @map("etapa_id") @db.Uuid
  numero         Int
  fazendaId      String?           @map("fazenda_id") @db.Uuid // nulo = mistura fazendas (MIX)
  safraId        String            @map("safra_id") @db.Uuid
  localId        String?           @map("local_id") @db.Uuid
  turnoId        String?           @map("turno_id") @db.Uuid
  talhaoId       String?           @map("talhao_id") @db.Uuid // só COLHEITA: talhão da carga
  modoColheita   ModoColheita?     @map("modo_colheita")
  contratoId     String?           @map("contrato_id") @db.Uuid // FK na Fase 5 (comercial)
  servicoTipo    TipoServico?      @map("servico_tipo")
  natureza       NaturezaMovimento @default(NORMAL)
  dataEntrada    DateTime          @default(now()) @map("data_entrada") @db.Timestamptz(6)
  dataSaidaLocal DateTime?         @map("data_saida_local") @db.Timestamptz(6)
  dataResultado  DateTime?         @map("data_resultado") @db.Timestamptz(6)
  status         StatusMovimento   @default(ABERTO)
  conferente     String?
  operador       String?
  observacao     String?
  unidade        Unidade
  qtdEntrada     Decimal           @default(0) @map("qtd_entrada") @db.Decimal(14, 3)
  qtdSaida       Decimal?          @map("qtd_saida") @db.Decimal(14, 3)
  qtdPerda       Decimal?          @map("qtd_perda") @db.Decimal(14, 3)
  percQuebra     Decimal?          @map("perc_quebra") @db.Decimal(9, 6)
  rendimento     Decimal?          @db.Decimal(12, 3) // kg por medida (ESTOQUE, RN-10)
  umidadeFinal   Decimal?          @map("umidade_final") @db.Decimal(5, 2)
  misturaSafras  Json?             @map("mistura_safras") // BLEND com várias safras (RN-13)
  motivoQuebra   String?           @map("motivo_quebra") // quebra acima do limite do tipo de serviço (RN-31)
  finalizadoEm   DateTime?         @map("finalizado_em") @db.Timestamptz(6)
  finalizadoPor  String?           @map("finalizado_por") @db.Uuid
  estornadoEm    DateTime?         @map("estornado_em") @db.Timestamptz(6)
  estornadoPor   String?           @map("estornado_por") @db.Uuid
  motivoEstorno  String?           @map("motivo_estorno")
  criadoEm       DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor      String?           @map("criado_por") @db.Uuid
  alteradoEm     DateTime          @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor    String?           @map("alterado_por") @db.Uuid

  etapa    Etapa              @relation(fields: [empresaId, etapaId], references: [empresaId, id])
  fazenda  Fazenda?           @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  safra    Safra              @relation(fields: [empresaId, safraId], references: [empresaId, id])
  local    Local?             @relation(fields: [empresaId, localId], references: [empresaId, id])
  talhao   Talhao?            @relation(fields: [empresaId, talhaoId], references: [empresaId, id])
  entradas MovimentoEntrada[]
  lotes    Lote[]
  reservas Reserva[]

  carga CargaColheita?

  leituras LeituraSecagem[]

  contrato Contrato?        @relation(fields: [empresaId, contratoId], references: [empresaId, id])
  embarque EmbarqueDetalhe?
  notas    EmbarqueNota[]

  rebaixamentos Rebaixamento[]
  dossies       Dossie[]
  pacotes       PacoteEmbarque[]

  @@unique([empresaId, etapaId, numero])
  @@unique([empresaId, id])
  @@index([empresaId, localId, status])
  @@map("movimento")
}

/// Lote consumido por um movimento. Cancelada = retirada enquanto o movimento estava aberto.
model MovimentoEntrada {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String        @map("empresa_id") @db.Uuid
  movimentoId   String        @map("movimento_id") @db.Uuid
  loteId        String        @map("lote_id") @db.Uuid
  quantidade    Decimal       @db.Decimal(14, 3)
  unidade       Unidade
  data          DateTime      @default(now()) @db.Timestamptz(6)
  origemReserva OrigemReserva @default(NENHUMA) @map("origem_reserva")
  reservaId     String?       @map("reserva_id") @db.Uuid
  localOrigemId String?       @map("local_origem_id") @db.Uuid // ESTOQUE: quadra de onde saiu (RN-25)
  cancelada     Boolean       @default(false)
  criadoEm      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor     String?       @map("criado_por") @db.Uuid
  alteradoEm    DateTime      @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor   String?       @map("alterado_por") @db.Uuid

  movimento Movimento @relation(fields: [empresaId, movimentoId], references: [empresaId, id])
  lote      Lote      @relation(fields: [empresaId, loteId], references: [empresaId, id])

  @@unique([movimentoId, loteId])
  @@index([empresaId, loteId])
  @@map("movimento_entrada")
}

/// Quantidade identificada de café, sempre gerada por um movimento. Saldo = quantidade − utilizada (RN-01).
model Lote {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String     @map("empresa_id") @db.Uuid
  codigo              String
  movimentoId         String     @map("movimento_id") @db.Uuid
  etapaId             String     @map("etapa_id") @db.Uuid
  fazendaId           String?    @map("fazenda_id") @db.Uuid // nulo = MIX
  safraId             String     @map("safra_id") @db.Uuid
  tipoCafeId          String?    @map("tipo_cafe_id") @db.Uuid
  peneiraId           String?    @map("peneira_id") @db.Uuid
  unidade             Unidade
  quantidade          Decimal    @db.Decimal(14, 3)
  quantidadeUtilizada Decimal    @default(0) @map("quantidade_utilizada") @db.Decimal(14, 3)
  quantidadeReservada Decimal    @default(0) @map("quantidade_reservada") @db.Decimal(14, 3)
  percentual          Decimal?   @db.Decimal(9, 6)
  umidade             Decimal?   @db.Decimal(5, 2)
  status              StatusLote @default(ABERTO)
  origemTipo          OrigemLote @map("origem_tipo")
  fontes              String[]   @default([]) @db.Uuid // entradas do movimento que formam este lote (vazio = todas)
  data                DateTime   @default(now()) @db.Timestamptz(6)
  observacao          String?
  criadoEm            DateTime   @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor           String?    @map("criado_por") @db.Uuid
  alteradoEm          DateTime   @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor         String?    @map("alterado_por") @db.Uuid

  movimento    Movimento          @relation(fields: [empresaId, movimentoId], references: [empresaId, id])
  etapa        Etapa              @relation(fields: [empresaId, etapaId], references: [empresaId, id])
  fazenda      Fazenda?           @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  safra        Safra              @relation(fields: [empresaId, safraId], references: [empresaId, id])
  tipoCafe     TipoCafe?          @relation(fields: [empresaId, tipoCafeId], references: [empresaId, id])
  peneira      Peneira?           @relation(fields: [empresaId, peneiraId], references: [empresaId, id])
  certificados LoteCertificado[]
  talhoes      LoteTalhao[]
  entradas     MovimentoEntrada[]
  reservas     Reserva[]

  locais     LoteLocal[]
  remocoes   Remocao[]
  inventario InventarioItem[]

  amostras Amostra[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, id])
  @@index([empresaId, etapaId, status])
  @@map("lote")
}

/// Certificado do lote (RN-08). Remoção no estoque fica registrada, nunca apagada.
model LoteCertificado {
  empresaId     String    @map("empresa_id") @db.Uuid
  loteId        String    @map("lote_id") @db.Uuid
  certificadoId String    @map("certificado_id") @db.Uuid
  removidoEm    DateTime? @map("removido_em") @db.Timestamptz(6)
  removidoPor   String?   @map("removido_por") @db.Uuid
  motivoRemocao String?   @map("motivo_remocao")

  lote        Lote        @relation(fields: [empresaId, loteId], references: [empresaId, id])
  certificado Certificado @relation(fields: [empresaId, certificadoId], references: [empresaId, id])

  @@id([loteId, certificadoId])
  @@map("lote_certificado")
}

/// Composição materializada do lote por talhão (RN-09). Σ percentual = 1.
model LoteTalhao {
  empresaId             String  @map("empresa_id") @db.Uuid
  loteId                String  @map("lote_id") @db.Uuid
  talhaoId              String  @map("talhao_id") @db.Uuid
  percentual            Decimal @db.Decimal(11, 10)
  quantidadeEquivalente Decimal @map("quantidade_equivalente") @db.Decimal(14, 3)

  lote   Lote   @relation(fields: [empresaId, loteId], references: [empresaId, id])
  talhao Talhao @relation(fields: [empresaId, talhaoId], references: [empresaId, id])

  @@id([loteId, talhaoId])
  @@index([empresaId, talhaoId])
  @@map("lote_talhao")
}

/// Quantidade de um lote separada para um uso (RN-07). Σ reservas ativas ≤ saldo.
model Reserva {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String            @map("empresa_id") @db.Uuid
  loteId             String            @map("lote_id") @db.Uuid
  localId            String?           @map("local_id") @db.Uuid
  quantidade         Decimal           @db.Decimal(14, 3)
  finalidade         FinalidadeReserva
  contratoId         String?           @map("contrato_id") @db.Uuid // FK na Fase 5
  movimentoId        String?           @map("movimento_id") @db.Uuid
  status             StatusReserva     @default(ATIVA)
  observacao         String?
  consumidaEm        DateTime?         @map("consumida_em") @db.Timestamptz(6)
  canceladaEm        DateTime?         @map("cancelada_em") @db.Timestamptz(6)
  motivoCancelamento String?           @map("motivo_cancelamento")
  criadoEm           DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor          String?           @map("criado_por") @db.Uuid
  alteradoEm         DateTime          @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor        String?           @map("alterado_por") @db.Uuid

  lote      Lote       @relation(fields: [empresaId, loteId], references: [empresaId, id])
  local     Local?     @relation(fields: [empresaId, localId], references: [empresaId, id])
  movimento Movimento? @relation(fields: [empresaId, movimentoId], references: [empresaId, id])

  contrato Contrato? @relation(fields: [empresaId, contratoId], references: [empresaId, id])

  @@index([empresaId, loteId, status])
  @@map("reserva")
}

// ---------------------------------------------------------------- Fase 3: saldo por local, remoção e inventário (RN-25, RN-29)

enum NaturezaMovimento {
  NORMAL
  AJUSTE_INVENTARIO

  @@map("natureza_movimento")
}

/// Saldo do lote em cada local das etapas ESTOQUE. Σ por lote = saldo do lote (RN-25).
model LoteLocal {
  empresaId  String   @map("empresa_id") @db.Uuid
  loteId     String   @map("lote_id") @db.Uuid
  localId    String   @map("local_id") @db.Uuid
  quantidade Decimal  @db.Decimal(14, 3)
  alteradoEm DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)

  lote  Lote  @relation(fields: [empresaId, loteId], references: [empresaId, id])
  local Local @relation(fields: [empresaId, localId], references: [empresaId, id])

  @@id([loteId, localId])
  @@index([empresaId, localId])
  @@map("lote_local")
}

/// Troca de local dentro do armazém: não muda o saldo do lote (RN-25).
model Remocao {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  loteId         String   @map("lote_id") @db.Uuid
  localOrigemId  String   @map("local_origem_id") @db.Uuid
  localDestinoId String   @map("local_destino_id") @db.Uuid
  quantidade     Decimal  @db.Decimal(14, 3)
  motivo         String?
  data           DateTime @default(now()) @db.Timestamptz(6)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor      String?  @map("criado_por") @db.Uuid

  lote Lote @relation(fields: [empresaId, loteId], references: [empresaId, id])

  @@index([empresaId, loteId])
  @@map("remocao")
}

enum StatusInventario {
  ABERTO
  CONTADO
  APROVADO
  CANCELADO

  @@map("status_inventario")
}

/// Contagem física de locais. Só a aprovação ajusta o estoque (RN-29).
model Inventario {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String           @map("empresa_id") @db.Uuid
  numero             Int
  localIds           String[]         @map("local_ids") @db.Uuid
  dataContagem       DateTime         @default(now()) @map("data_contagem") @db.Timestamptz(6)
  status             StatusInventario @default(ABERTO)
  observacao         String?
  aprovadoPor        String?          @map("aprovado_por") @db.Uuid
  aprovadoEm         DateTime?        @map("aprovado_em") @db.Timestamptz(6)
  canceladoEm        DateTime?        @map("cancelado_em") @db.Timestamptz(6)
  motivoCancelamento String?          @map("motivo_cancelamento")
  criadoEm           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor          String?          @map("criado_por") @db.Uuid
  alteradoEm         DateTime         @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor        String?          @map("alterado_por") @db.Uuid

  itens InventarioItem[]

  @@unique([empresaId, numero])
  @@unique([empresaId, id])
  @@map("inventario")
}

model InventarioItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  inventarioId      String   @map("inventario_id") @db.Uuid
  loteId            String   @map("lote_id") @db.Uuid
  localId           String   @map("local_id") @db.Uuid
  qtdSistema        Decimal  @map("qtd_sistema") @db.Decimal(14, 3)
  qtdContada        Decimal? @map("qtd_contada") @db.Decimal(14, 3)
  diferenca         Decimal? @db.Decimal(14, 3)
  ajusteMovimentoId String?  @map("ajuste_movimento_id") @db.Uuid
  alteradoEm        DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor       String?  @map("alterado_por") @db.Uuid

  inventario Inventario @relation(fields: [empresaId, inventarioId], references: [empresaId, id])
  lote       Lote       @relation(fields: [empresaId, loteId], references: [empresaId, id])

  @@unique([inventarioId, loteId, localId])
  @@map("inventario_item")
}

// ---------------------------------------------------------------- Fase 4: colhedores, apontamento e pagamento (§4.5, §6)

model Turma {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  fazendaId   String   @map("fazenda_id") @db.Uuid
  nome        String
  responsavel String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  fazenda      Fazenda       @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  colhedores   Colhedor[]
  apontamentos Apontamento[]

  @@unique([fazendaId, nome])
  @@unique([empresaId, id])
  @@map("turma")
}

/// Colhedor. CPF e chave PIX são dados pessoais: cifrados, mascarados e auditados ao revelar (§3.3).
model Colhedor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  turmaId     String?  @map("turma_id") @db.Uuid
  nome        String
  apelido     String?
  cpfCifrado  String?  @map("cpf_cifrado")
  cpfMascara  String?  @map("cpf_mascara")
  cpfHash     String?  @map("cpf_hash") // HMAC: impede CPF repetido sem guardar o CPF aberto
  pixCifrado  String?  @map("pix_cifrado")
  pixMascara  String?  @map("pix_mascara")
  telefone    String?
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid
  alteradoEm  DateTime @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor String?  @map("alterado_por") @db.Uuid

  turma        Turma?               @relation(fields: [empresaId, turmaId], references: [empresaId, id])
  apontamentos Apontamento[]
  lancamentos  LancamentoColhedor[]
  itens        FechamentoItem[]

  @@unique([empresaId, id])
  @@map("colhedor")
}

enum StatusApontamento {
  PENDENTE
  FECHADO
  CANCELADO

  @@map("status_apontamento")
}

/// Medidas de um colhedor num talhão num dia (RN-19). O id é o UUID gerado no aparelho.
model Apontamento {
  id              String            @id @db.Uuid
  empresaId       String            @map("empresa_id") @db.Uuid
  data            DateTime          @db.Date
  fazendaId       String            @map("fazenda_id") @db.Uuid
  talhaoId        String            @map("talhao_id") @db.Uuid
  safraId         String            @map("safra_id") @db.Uuid
  colhedorId      String            @map("colhedor_id") @db.Uuid
  turmaId         String?           @map("turma_id") @db.Uuid
  tipoCafeId      String?           @map("tipo_cafe_id") @db.Uuid
  tipoColheita    TipoColheitaPreco @default(MANUAL) @map("tipo_colheita")
  medidas         Decimal           @db.Decimal(14, 3)
  apontadorId     String?           @map("apontador_id") @db.Uuid
  dispositivoId   String?           @map("dispositivo_id")
  criadoOfflineEm DateTime?         @map("criado_offline_em") @db.Timestamptz(6)
  sincronizadoEm  DateTime          @default(now()) @map("sincronizado_em") @db.Timestamptz(6)
  versao          Int               @default(1) // muda a cada correção no servidor (RN-23)
  valorUnitario   Decimal?          @map("valor_unitario") @db.Decimal(14, 2) // congelado no fechamento (RN-20)
  status          StatusApontamento @default(PENDENTE)
  fechamentoId    String?           @map("fechamento_id") @db.Uuid
  motivoCorrecao  String?           @map("motivo_correcao")
  criadoEm        DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  alteradoEm      DateTime          @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor     String?           @map("alterado_por") @db.Uuid

  fazenda    Fazenda              @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  talhao     Talhao               @relation(fields: [empresaId, talhaoId], references: [empresaId, id])
  safra      Safra                @relation(fields: [empresaId, safraId], references: [empresaId, id])
  colhedor   Colhedor             @relation(fields: [empresaId, colhedorId], references: [empresaId, id])
  turma      Turma?               @relation(fields: [empresaId, turmaId], references: [empresaId, id])
  fechamento FechamentoPagamento? @relation(fields: [empresaId, fechamentoId], references: [empresaId, id])
  origens    ApontamentoOrigem[]
  cargas     CargaApontamento[]

  @@unique([empresaId, id])
  @@index([empresaId, fazendaId, data, status])
  @@map("apontamento")
}

/// Cada registro vindo de um aparelho (UUID próprio) e quanto ele soma no apontamento (RN-19, RN-23).
model ApontamentoOrigem {
  id              String    @id @db.Uuid
  empresaId       String    @map("empresa_id") @db.Uuid
  apontamentoId   String    @map("apontamento_id") @db.Uuid
  medidas         Decimal   @db.Decimal(14, 3)
  dispositivoId   String?   @map("dispositivo_id")
  criadoOfflineEm DateTime? @map("criado_offline_em") @db.Timestamptz(6)
  recebidoEm      DateTime  @default(now()) @map("recebido_em") @db.Timestamptz(6)
  alteradoEm      DateTime  @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)

  apontamento Apontamento @relation(fields: [empresaId, apontamentoId], references: [empresaId, id])

  @@index([empresaId, apontamentoId])
  @@map("apontamento_origem")
}

enum TipoColheitaCarga {
  MANUAL
  SEMIMECANIZADA
  MECANICA
  VARIOS

  @@map("tipo_colheita_carga")
}

/// O que sai do talhão para o pós-colheita (§6.2). Gera o movimento COLHEITA com 1 lote.
model CargaColheita {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String            @map("empresa_id") @db.Uuid
  data              DateTime          @db.Date
  fazendaId         String            @map("fazenda_id") @db.Uuid
  talhaoId          String            @map("talhao_id") @db.Uuid
  safraId           String            @map("safra_id") @db.Uuid
  tipoCafeId        String            @map("tipo_cafe_id") @db.Uuid
  tipoColheita      TipoColheitaCarga @map("tipo_colheita")
  tipoTransporte    String?           @map("tipo_transporte")
  operadorMaquina   String?           @map("operador_maquina")
  medidasMedidas    Decimal           @map("medidas_medidas") @db.Decimal(14, 3)
  medidasApontadas  Decimal           @default(0) @map("medidas_apontadas") @db.Decimal(14, 3)
  divergencia       Decimal           @default(0) @db.Decimal(14, 3)
  divergenciaPerc   Decimal?          @map("divergencia_perc") @db.Decimal(9, 6)
  alertaDivergencia Boolean           @default(false) @map("alerta_divergencia")
  movimentoId       String            @map("movimento_id") @db.Uuid
  criadoEm          DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor         String?           @map("criado_por") @db.Uuid

  fazenda      Fazenda            @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  talhao       Talhao             @relation(fields: [empresaId, talhaoId], references: [empresaId, id])
  safra        Safra              @relation(fields: [empresaId, safraId], references: [empresaId, id])
  movimento    Movimento          @relation(fields: [empresaId, movimentoId], references: [empresaId, id])
  apontamentos CargaApontamento[]

  @@unique([empresaId, movimentoId])
  @@unique([empresaId, id])
  @@index([empresaId, data])
  @@map("carga_colheita")
}

model CargaApontamento {
  empresaId     String @map("empresa_id") @db.Uuid
  cargaId       String @map("carga_id") @db.Uuid
  apontamentoId String @map("apontamento_id") @db.Uuid // uma carga ativa por apontamento: conferido no serviço

  carga       CargaColheita @relation(fields: [empresaId, cargaId], references: [empresaId, id])
  apontamento Apontamento   @relation(fields: [empresaId, apontamentoId], references: [empresaId, id])

  @@id([cargaId, apontamentoId])
  @@index([empresaId, apontamentoId])
  @@map("carga_apontamento")
}

enum StatusFechamento {
  ABERTO
  FECHADO
  PAGO
  CANCELADO

  @@map("status_fechamento")
}

/// Fechamento de pagamento de uma fazenda num período (§6.3). Períodos não se sobrepõem (RN-21).
model FechamentoPagamento {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String           @map("empresa_id") @db.Uuid
  numero             Int
  fazendaId          String           @map("fazenda_id") @db.Uuid
  periodoInicio      DateTime         @map("periodo_inicio") @db.Date
  periodoFim         DateTime         @map("periodo_fim") @db.Date
  status             StatusFechamento @default(ABERTO)
  totalMedidas       Decimal          @default(0) @map("total_medidas") @db.Decimal(14, 3)
  totalBruto         Decimal          @default(0) @map("total_bruto") @db.Decimal(14, 2)
  totalDescontos     Decimal          @default(0) @map("total_descontos") @db.Decimal(14, 2)
  totalLiquido       Decimal          @default(0) @map("total_liquido") @db.Decimal(14, 2)
  fechadoPor         String?          @map("fechado_por") @db.Uuid
  fechadoEm          DateTime?        @map("fechado_em") @db.Timestamptz(6)
  pagoPor            String?          @map("pago_por") @db.Uuid
  pagoEm             DateTime?        @map("pago_em") @db.Timestamptz(6)
  motivoReabertura   String?          @map("motivo_reabertura")
  motivoCancelamento String?          @map("motivo_cancelamento")
  criadoEm           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor          String?          @map("criado_por") @db.Uuid
  alteradoEm         DateTime         @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor        String?          @map("alterado_por") @db.Uuid

  fazenda      Fazenda              @relation(fields: [empresaId, fazendaId], references: [empresaId, id])
  itens        FechamentoItem[]
  apontamentos Apontamento[]
  lancamentos  LancamentoColhedor[]

  @@unique([empresaId, numero])
  @@unique([empresaId, id])
  @@map("fechamento_pagamento")
}

model FechamentoItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String  @map("empresa_id") @db.Uuid
  fechamentoId  String  @map("fechamento_id") @db.Uuid
  colhedorId    String  @map("colhedor_id") @db.Uuid
  medidas       Decimal @db.Decimal(14, 3)
  valorBruto    Decimal @map("valor_bruto") @db.Decimal(14, 2)
  adiantamentos Decimal @default(0) @db.Decimal(14, 2)
  descontos     Decimal @default(0) @db.Decimal(14, 2)
  adicionais    Decimal @default(0) @db.Decimal(14, 2)
  valorLiquido  Decimal @map("valor_liquido") @db.Decimal(14, 2)

  fechamento FechamentoPagamento @relation(fields: [empresaId, fechamentoId], references: [empresaId, id])
  colhedor   Colhedor            @relation(fields: [empresaId, colhedorId], references: [empresaId, id])

  @@unique([fechamentoId, colhedorId])
  @@map("fechamento_item")
}

enum TipoLancamentoColhedor {
  ADIANTAMENTO
  DESCONTO
  ADICIONAL

  @@map("tipo_lancamento_colhedor")
}

model LancamentoColhedor {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId    String                 @map("empresa_id") @db.Uuid
  colhedorId   String                 @map("colhedor_id") @db.Uuid
  data         DateTime               @db.Date
  tipo         TipoLancamentoColhedor
  valor        Decimal                @db.Decimal(14, 2)
  descricao    String?
  fechamentoId String?                @map("fechamento_id") @db.Uuid
  cancelado    Boolean                @default(false)
  criadoEm     DateTime               @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor    String?                @map("criado_por") @db.Uuid

  colhedor   Colhedor             @relation(fields: [empresaId, colhedorId], references: [empresaId, id])
  fechamento FechamentoPagamento? @relation(fields: [empresaId, fechamentoId], references: [empresaId, id])

  @@index([empresaId, colhedorId])
  @@map("lancamento_colhedor")
}

// ---------------------------------------------------------------- Fase 5: secagem e alertas (§4.6, §7)

/// Leitura de umidade/temperatura de um movimento em secagem. O id é o UUID gerado no aparelho (RN-23).
model LeituraSecagem {
  id               String   @id @db.Uuid
  empresaId        String   @map("empresa_id") @db.Uuid
  movimentoId      String   @map("movimento_id") @db.Uuid
  dataHora         DateTime @map("data_hora") @db.Timestamptz(6)
  umidade          Decimal  @db.Decimal(5, 2)
  temperaturaMassa Decimal? @map("temperatura_massa") @db.Decimal(5, 1)
  temperaturaAr    Decimal? @map("temperatura_ar") @db.Decimal(5, 1)
  observacao       String?
  usuarioId        String?  @map("usuario_id") @db.Uuid
  dispositivoId    String?  @map("dispositivo_id")
  cancelada        Boolean  @default(false)
  criadoEm         DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  movimento Movimento @relation(fields: [empresaId, movimentoId], references: [empresaId, id])

  @@index([empresaId, movimentoId, dataHora])
  @@map("leitura_secagem")
}

enum TipoAlerta {
  PONTO_SECAGEM
  SECAGEM_LONGA
  CAPACIDADE
  CERTIFICADO_VENCENDO
  CONTRATO_PRAZO
  EUDR_PENDENTE
  SOBREPOSICAO_TALHAO
  DIVERGENCIA_CARGA

  @@map("tipo_alerta")
}

enum SeveridadeAlerta {
  INFO
  AVISO
  CRITICO

  @@map("severidade_alerta")
}

/// Central de alertas (§4.6). "chave" evita repetir o mesmo alerta (ex.: PONTO_SECAGEM:<movimento>).
model Alerta {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String           @map("empresa_id") @db.Uuid
  tipo       TipoAlerta
  chave      String
  entidade   String
  entidadeId String           @map("entidade_id") @db.Uuid
  mensagem   String
  severidade SeveridadeAlerta @default(AVISO)
  criadoEm   DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  lidoPor    String?          @map("lido_por") @db.Uuid
  lidoEm     DateTime?        @map("lido_em") @db.Timestamptz(6)

  @@unique([empresaId, chave])
  @@index([empresaId, lidoEm])
  @@map("alerta")
}

// ---------------------------------------------------------------- Fase 6: comercial (§4.7, §9)

enum StatusContrato {
  RASCUNHO
  ASSINADO
  EM_EXECUCAO
  CONCLUIDO
  CANCELADO

  @@map("status_contrato")
}

enum Moeda {
  BRL
  USD

  @@map("moeda")
}

enum TipoPreco {
  FIXO
  A_FIXAR

  @@map("tipo_preco")
}

/// Compromisso de venda (§9). quantidade_kg, kg reservado, embarcado e saldo são derivados (regra 5).
model Contrato {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String         @map("empresa_id") @db.Uuid
  numero              Int
  ano                 Int
  codigo              String
  clienteId           String         @map("cliente_id") @db.Uuid
  safraId             String?        @map("safra_id") @db.Uuid
  quantidadeSacas     Decimal        @map("quantidade_sacas") @db.Decimal(12, 3)
  toleranciaPerc      Decimal        @default(0) @map("tolerancia_perc") @db.Decimal(7, 6)
  descricaoPadrao     String?        @map("descricao_padrao")
  peneiraMinId        String?        @map("peneira_min_id") @db.Uuid
  moeda               Moeda          @default(BRL)
  tipoPreco           TipoPreco      @map("tipo_preco")
  precoPorSaca        Decimal?       @map("preco_por_saca") @db.Decimal(14, 2)
  diferencial         Decimal?       @db.Decimal(14, 2)
  referenciaBolsa     String?        @map("referencia_bolsa")
  prazoEmbarqueInicio DateTime?      @map("prazo_embarque_inicio") @db.Date
  prazoEmbarqueFim    DateTime?      @map("prazo_embarque_fim") @db.Date
  incoterm            String?
  destinoPais         String?        @map("destino_pais")
  exigeEudr           Boolean        @default(false) @map("exige_eudr")
  status              StatusContrato @default(RASCUNHO)
  observacao          String?
  assinadoEm          DateTime?      @map("assinado_em") @db.Timestamptz(6)
  concluidoEm         DateTime?      @map("concluido_em") @db.Timestamptz(6)
  motivoCancelamento  String?        @map("motivo_cancelamento")
  criadoEm            DateTime       @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor           String?        @map("criado_por") @db.Uuid
  alteradoEm          DateTime       @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor         String?        @map("alterado_por") @db.Uuid

  cliente      Parceiro              @relation(fields: [empresaId, clienteId], references: [empresaId, id])
  safra        Safra?                @relation(fields: [empresaId, safraId], references: [empresaId, id])
  peneiraMin   Peneira?              @relation(fields: [empresaId, peneiraMinId], references: [empresaId, id])
  certificados ContratoCertificado[]
  fixacoes     FixacaoPreco[]
  amostras     Amostra[]
  reservas     Reserva[]
  movimentos   Movimento[]
  embarques    EmbarqueDetalhe[]

  @@unique([empresaId, codigo])
  @@unique([empresaId, ano, numero])
  @@unique([empresaId, id])
  @@map("contrato")
}

model ContratoCertificado {
  empresaId     String @map("empresa_id") @db.Uuid
  contratoId    String @map("contrato_id") @db.Uuid
  certificadoId String @map("certificado_id") @db.Uuid

  contrato    Contrato    @relation(fields: [empresaId, contratoId], references: [empresaId, id])
  certificado Certificado @relation(fields: [empresaId, certificadoId], references: [empresaId, id])

  @@id([contratoId, certificadoId])
  @@map("contrato_certificado")
}

/// Fixação parcial de preço (contrato A_FIXAR). Σ sacas ≤ quantidade do contrato.
model FixacaoPreco {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  contratoId   String   @map("contrato_id") @db.Uuid
  data         DateTime @db.Date
  sacas        Decimal  @db.Decimal(12, 3)
  precoPorSaca Decimal  @map("preco_por_saca") @db.Decimal(14, 2)
  observacao   String?
  cancelada    Boolean  @default(false)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor    String?  @map("criado_por") @db.Uuid

  contrato Contrato @relation(fields: [empresaId, contratoId], references: [empresaId, id])

  @@map("fixacao_preco")
}

enum StatusAmostra {
  ENVIADA
  APROVADA
  REPROVADA
  SEM_RETORNO

  @@map("status_amostra")
}

model Amostra {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String        @map("empresa_id") @db.Uuid
  contratoId        String?       @map("contrato_id") @db.Uuid
  clienteId         String        @map("cliente_id") @db.Uuid
  loteId            String        @map("lote_id") @db.Uuid
  pesoG             Int           @map("peso_g")
  dataEnvio         DateTime      @map("data_envio") @db.Date
  transportadora    String?
  rastreio          String?
  status            StatusAmostra @default(ENVIADA)
  dataRetorno       DateTime?     @map("data_retorno") @db.Date
  comentarioCliente String?       @map("comentario_cliente")
  criadoEm          DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor         String?       @map("criado_por") @db.Uuid
  alteradoEm        DateTime      @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor       String?       @map("alterado_por") @db.Uuid

  contrato Contrato? @relation(fields: [empresaId, contratoId], references: [empresaId, id])
  cliente  Parceiro  @relation(fields: [empresaId, clienteId], references: [empresaId, id])
  lote     Lote      @relation(fields: [empresaId, loteId], references: [empresaId, id])

  @@index([empresaId, loteId])
  @@map("amostra")
}

/// Detalhe do embarque (movimento da classe SAIDA): programação (RN-26), carregamento (RN-27) e logística.
model EmbarqueDetalhe {
  movimentoId          String    @id @map("movimento_id") @db.Uuid
  empresaId            String    @map("empresa_id") @db.Uuid
  contratoId           String    @map("contrato_id") @db.Uuid
  clienteId            String    @map("cliente_id") @db.Uuid
  dataVenda            DateTime? @map("data_venda") @db.Date
  dataEmbarque         DateTime? @map("data_embarque") @db.Date
  container            String?
  navio                String?
  booking              String?
  numeroDds            String?   @map("numero_dds")
  programadoEm         DateTime? @map("programado_em") @db.Timestamptz(6)
  programadoPor        String?   @map("programado_por") @db.Uuid
  motoristaId          String?   @map("motorista_id") @db.Uuid
  placa                String?
  transportadorId      String?   @map("transportador_id") @db.Uuid
  lacres               String[]  @default([])
  pesoBruto            Decimal?  @map("peso_bruto") @db.Decimal(14, 3)
  tara                 Decimal?  @db.Decimal(14, 3)
  pesoLiquido          Decimal?  @map("peso_liquido") @db.Decimal(14, 3)
  diferencaKg          Decimal?  @map("diferenca_kg") @db.Decimal(14, 3)
  diferencaPerc        Decimal?  @map("diferenca_perc") @db.Decimal(9, 6)
  motivoDiferenca      String?   @map("motivo_diferenca")
  carregadoEm          DateTime? @map("carregado_em") @db.Timestamptz(6)
  carregadoPor         String?   @map("carregado_por") @db.Uuid
  certificadosVendidos String[]  @default([]) @map("certificados_vendidos") @db.Uuid // "vender como" (RN-28); vazio = convencional
  vendaDefinida        Boolean   @default(false) @map("venda_definida")
  criadoEm             DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  alteradoEm           DateTime  @default(now()) @updatedAt @map("alterado_em") @db.Timestamptz(6)
  alteradoPor          String?   @map("alterado_por") @db.Uuid

  movimento Movimento  @relation(fields: [empresaId, movimentoId], references: [empresaId, id])
  contrato  Contrato   @relation(fields: [empresaId, contratoId], references: [empresaId, id])
  motorista Motorista? @relation(fields: [empresaId, motoristaId], references: [empresaId, id])

  @@unique([empresaId, movimentoId])
  @@map("embarque_detalhe")
}

model EmbarqueNota {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  movimentoId String   @map("movimento_id") @db.Uuid
  numeroNota  String   @map("numero_nota")
  serie       String?
  chaveNfe    String?  @map("chave_nfe")
  dataEmissao DateTime @map("data_emissao") @db.Date
  qtdKg       Decimal  @map("qtd_kg") @db.Decimal(14, 3)
  qtdSacas    Decimal  @map("qtd_sacas") @db.Decimal(12, 3)
  cancelada   Boolean  @default(false)
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor   String?  @map("criado_por") @db.Uuid

  movimento Movimento @relation(fields: [empresaId, movimentoId], references: [empresaId, id])

  @@index([empresaId, movimentoId])
  @@map("embarque_nota")
}

// ---------------------------------------------------------------- Fase 7: certificações, EUDR, dossiê e pacote (§4.8, §10, §17)

/// Arquivo enviado (evidência de checagem, certificado). Guardado no banco; nunca alterado nem apagado.
model Arquivo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nome      String
  tipo      String
  tamanho   Int
  sha256    String
  conteudo  Bytes
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor String?  @map("criado_por") @db.Uuid

  checagens    ChecagemDesmatamento[]
  certificados FazendaCertificado[]

  @@unique([empresaId, id])
  @@map("arquivo")
}

enum ResultadoChecagem {
  SEM_ALERTA
  ALERTA
  INCONCLUSIVO
  ERRO

  @@map("resultado_checagem")
}

/// Checagem de desmatamento de um talhão (§10). Vale para a versão da geometria em que foi feita.
model ChecagemDesmatamento {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String            @map("empresa_id") @db.Uuid
  talhaoId            String            @map("talhao_id") @db.Uuid
  provedor            String
  dataChecagem        DateTime          @map("data_checagem") @db.Date
  dataCorte           DateTime          @map("data_corte") @db.Date
  resultado           ResultadoChecagem
  areaAlertaHa        Decimal?          @map("area_alerta_ha") @db.Decimal(14, 4)
  evidencia           Json?
  arquivoId           String?           @map("arquivo_id") @db.Uuid
  versaoGeometriaHash String            @map("versao_geometria_hash")
  observacao          String?
  criadoEm            DateTime          @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor           String?           @map("criado_por") @db.Uuid

  talhao  Talhao   @relation(fields: [empresaId, talhaoId], references: [empresaId, id])
  arquivo Arquivo? @relation(fields: [empresaId, arquivoId], references: [empresaId, id])

  @@index([empresaId, talhaoId, criadoEm])
  @@map("checagem_desmatamento")
}

/// Rebaixamento de certificado (RN-28): kg de um lote de origem que perderam esquemas num serviço ou na venda.
model Rebaixamento {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String   @map("empresa_id") @db.Uuid
  movimentoId       String   @map("movimento_id") @db.Uuid
  loteOrigemId      String   @map("lote_origem_id") @db.Uuid
  loteResultadoId   String?  @map("lote_resultado_id") @db.Uuid // nulo na venda (embarque)
  kg                Decimal  @db.Decimal(14, 3)
  esquemasOrigem    String[] @map("esquemas_origem")
  esquemasResultado String[] @map("esquemas_resultado")
  esquemasPerdidos  String[] @map("esquemas_perdidos")
  motivo            String
  cancelado         Boolean  @default(false) // resultado apagado / movimento estornado
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  criadoPor         String?  @map("criado_por") @db.Uuid

  movimento Movimento @relation(fields: [empresaId, movimentoId], references: [empresaId, id])

  @@index([empresaId, movimentoId])
  @@map("rebaixamento")
}

/// Dossiê EUDR/certificações do embarque (§10): gerado sob demanda; a versão da finalização fica congelada.
model Dossie {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  movimentoId String   @map("movimento_id") @db.Uuid
  versao      Int
  geradoEm    DateTime @default(now()) @map("gerado_em") @db.Timestamptz(6)
  geradoPor   String?  @map("gerado_por") @db.Uuid
  conteudo    Json
  hashSha256  String   @map("hash_sha256")
  pendencias  Int
  congelado   Boolean  @default(false)

  movimento Movimento @relation(fields: [empresaId, movimentoId], references: [empresaId, id])

  @@unique([empresaId, movimentoId, versao])
  @@map("dossie")
}

/// Pacote de embarque para a exportadora (§17, RN-30). Imutável; correção = nova versão com motivo.
model PacoteEmbarque {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  movimentoId String   @map("movimento_id") @db.Uuid
  versao      Int
  geradoEm    DateTime @default(now()) @map("gerado_em") @db.Timestamptz(6)
  geradoPor   String?  @map("gerado_por") @db.Uuid
  conteudo    Json
  geojson     Json
  hashSha256  String   @map("hash_sha256")
  motivo      String?

  movimento Movimento @relation(fields: [empresaId, movimentoId], references: [empresaId, id])

  @@unique([empresaId, movimentoId, versao])
  @@map("pacote_embarque")
}
